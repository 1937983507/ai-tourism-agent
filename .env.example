# OpenAI 配置
OPENAI_API_KEY=openai-api-key
OPENAI_BASE_URL=openai-base-url
OPENAI_MODEL_NAME=openai-model-name
OPENAI_MAX_OUTPUT_TOKENS=4000

# Checkpoint 配置（默认使用内存，可选 sqlite 或 postgres）
CHECKPOINT_TYPE=sqlite
SQLITE_DB_PATH=./checkpoints.db
POSTGRES_CONN_STRING=postgresql://user:password@localhost:5432/dbname

# Java 服务工具接口
# 请启动 https://github.com/1937983507/ai-tourism-backend 后端项目
JAVA_SERVICE_URL=http://localhost:8290
JAVA_SERVICE_INTERNAL_TOKEN=xxx

# 本Agent服务配置
AGENT_PORT=8291
AGENT_HOST=0.0.0.0

# 天气 API 配置（请到 http://api.openweathermap.org 进行获取）
OPENWEATHER_API_KEY=xxx

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=7
LOG_ROTATION=00:00
LOG_ENCODING=utf-8