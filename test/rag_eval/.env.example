# 评测用 OpenAI 配置（与主项目 .env 变量名不一致）
RAG_EVAL_OPENAI_API_KEY=your_api_key
RAG_EVAL_OPENAI_BASE_URL=https://api.openai.com/v1

# 用于两件事：答案生成 + RAGAS judge（默认同一个模型）
RAG_EVAL_LLM_MODEL_NAME=gpt-4o-mini
RAGAS_LLM_MODEL_NAME=gpt-4o-mini
# Step2 RAGAS 评判 LLM：结构化输出（尤其 Faithfulness NLI）需要足够大的 max_tokens，默认 1024 会长答案报错
RAG_EVAL_RAGAS_LLM_MAX_TOKENS=16384
# Faithfulness 仅对答案前 N 个字符做拆句+NLI（0=不截断）。长行程建议保留默认，避免 NLI JSON 仍超限
RAG_EVAL_RAGAS_FAITHFULNESS_ANSWER_MAX_CHARS=12000
# ContextRecall / ContextPrecisionWithReference 使用的 reference（ground_truth_answer）截断长度（0=不截断）
RAG_EVAL_RAGAS_REFERENCE_MAX_CHARS=12000

# embedding 模型（用于 AnswerRelevancy 等指标）
RAG_EVAL_EMBEDDING_MODEL_NAME=text-embedding-3-small

# LLM 生成参数
RAG_EVAL_ANSWER_TEMPERATURE=0.2
RAG_EVAL_MAX_TOKENS=600

# Step1：当 test_cases.json 的 ground_truth_answer 为空时，是否自动生成参考答案
RAG_EVAL_AUTO_GENERATE_GT_ANSWER=true
# GT 生成方式：travel_plan=中文多日行程形态（推荐）；ragas_testset=RAGAS 合成 QA（非行程）
RAG_EVAL_GT_SOURCE=travel_plan
# ragas_testset 模式下 TestsetGenerator 每次生成样本数（建议 1）
RAG_EVAL_GT_TESTSET_SIZE=1
# 行程形态 GT：抽样 chunk 与输出长度（可按模型上限调整）
RAG_EVAL_GT_PLAN_MAX_CHUNKS=32
RAG_EVAL_GT_PLAN_CHARS_PER_CHUNK=1000
RAG_EVAL_GT_PLAN_CONTEXT_CHAR_BUDGET=16000
RAG_EVAL_GT_PLAN_MAX_TOKENS=2500
# GT 语料范围：full=当前 Chroma collection 内最多 N 条 chunk；city=仅当前样例城市 metadata
RAG_EVAL_GT_CORPUS_SCOPE=full
# 单次加载 chunk 上限（防止过大；整库很大时可调高或改用 city）
RAG_EVAL_GT_MAX_CORPUS_DOCS=3000

# 向量库（评测使用自己的目录/集合）
RAG_EVAL_CHROMA_DIR=./chroma_db
RAG_EVAL_COLLECTION_NAME=travel_docs
RAG_EVAL_TOP_K=5
RAG_EVAL_CITY_METADATA_KEY=source_city

# 输出目录
RAG_EVAL_OUTPUT_DIR=./test/rag_eval/outputs
RAG_EVAL_RUN_NAME_PREFIX=rag_eval

