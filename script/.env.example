# =========================
# getTravelData/.env.example
# =========================
# 使用说明：
# 1) 把本文件复制为 `.env`
# 2) 只需要填写 `OPENAI_API_KEY`（如果你同时用到 openai embeddings 写入向量）
# 3) 语义切块（SemanticChunker）默认使用本地 Ollama 的 bge embedding：
#    - CHUNKER_BACKEND=ollama
#    - OLLAMA_BASE_URL / OLLAMA_MODEL
#
# 如果你仅仅是想验证代码跑通：
# - 先把 MAX_ROWS 设成 10~30
# - 再把 CHROMA_RESET 设成 true，避免重复写入污染
#

# ---- 向量写入（OpenAI Embeddings）----
# OpenAI API Key。用于把 chunk.page_content 向量化并写入 Chroma。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 向量写入 embedding 请求参数
EMBEDDING_REQUEST_TIMEOUT=60
EMBEDDING_SHOW_PROGRESS=false

# ---- Chroma 持久化 ----
CHROMA_DIR=../chroma_db
CHROMA_COLLECTION=travel_docs
CHROMA_RESET=false
CHROMA_BATCH_ADD=64

# ---- 输入数据 ----
DATA_CSV=./data.csv
DATA_CONTENT_COL=text
# metadata 字段集合：
# - `*` 表示把 CSV 全列都放进 metadata（用于检索时精准过滤）
# - `colA,colB` 表示只放指定列
# 注意：程序会自动排除 DATA_CONTENT_COL（通常是 text），避免正文重复进入 metadata。
DATA_META_COLS=*
# 只处理前 N 行；0 表示全量
MAX_ROWS=0

# ---- SemanticChunker（语义切块）----
# 切块策略：semantic / recursive
CHUNK_STRATEGY=semantic
# 切块生成模式：iter / bulk
# - iter：逐条原始 Document split（更省内存，边界不会跨文档）
# - bulk：一次性对所有 Document split（更快，但占用更多内存）
CHUNK_MODE=iter

# 切块 embedding 后端（用于 SemanticChunker 判断语义断点）：
# - ollama：使用本地 Ollama bge embedding
# - openai：使用远程 OpenAI embedding（同样用于语义断点判断）
CHUNKER_BACKEND=ollama

# Ollama embedding 参数（本地一般：http://localhost:11434）
OLLAMA_BASE_URL=http://localhost:11434
# 你在 Ollama 里部署的 embedding/bge 模型名（按你本机模型为准）
OLLAMA_MODEL=bge-small-zh-v1.5

# SemanticChunker breakpoint_threshold_amount（percentile）
SEMANTIC_BREAKPOINT_AMOUNT=90

# 是否在 chunk 的 metadata 中附加 start_index
# - True：metadata["start_index"] 表示该 chunk 在原始 page_content 里的起始字符偏移
SEMANTIC_ADD_START_INDEX=false

# min_chunk_size（0 表示不设置；>0 会强制 chunk 不小于该长度）
SEMANTIC_MIN_CHUNK_SIZE=0

# max_chunk_size（0 表示不限制；>0 会强制 chunk 不超过该长度）
# 建议：当 SEMANTIC_BREAKPOINT_AMOUNT 偏高导致块过长时，把它设为 500~800 进行兜底。
SEMANTIC_MAX_CHUNK_SIZE=0

# ---- RecursiveCharacterTextSplitter（仅 CHUNK_STRATEGY=recursive 时生效）----
RECURSIVE_CHUNK_SIZE=512
RECURSIVE_CHUNK_OVERLAP=64

